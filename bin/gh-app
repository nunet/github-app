#!/usr/bin/env bash
# gh-app -- act on GitHub as a GitHub App, with no human step and no stored token.
#
#   gh-app check              mint a token, report what the app can reach
#   gh-app exec <cmd...>      run ONE command as the app (gh, git, ...)
#
# A GitHub App has no long-lived token. Its long-lived credential is a private
# key; an installation token is derived from it and lives one hour, which GitHub
# does not let anyone change. So this tool mints a fresh token on every call:
#
#   sign a JWT with the key (RS256, iss = app id, 10 min)
#   -> GET  /app                          proves the key belongs to the app id
#   -> GET  /orgs/<org>/installation      finds the installation in that org
#   -> POST /app/installations/<id>/access_tokens
#
# The configuration is explicit and complete, so nothing is guessed. Everything
# comes from the environment (the harness resolves it from `pass`):
#
#   GITHUB_APP_ID            numeric app id
#   GITHUB_APP_PRIVATE_KEY   the app's private key, PEM, newlines intact
#   GITHUB_APP_NAME          the app's name or slug -- checked against GitHub
#   GITHUB_APP_ORG           the org the app is installed on
#
# A mismatch between any of these and what GitHub reports fails closed, with a
# message naming the variable. Nothing is cached: the token exists only in the
# environment of the one child `exec` starts, never on disk, never in argv,
# never on stdout. The key reaches openssl through a pipe, not a file.
#
# Under `exec` the child acts AS THE APP in every way GitHub records:
#   - gh reads GH_TOKEN, so issues, PRs, comments and discussions are the app's;
#   - git gets a credential helper for https://github.com for this child only
#     (GIT_CONFIG_COUNT env, the inherited helper list reset first), and
#     git@github.com: remotes are rewritten to https so that helper applies;
#   - GIT_AUTHOR_* and GIT_COMMITTER_* are set to <slug>[bot] and its noreply
#     address, so a commit made under exec is authored by the app too.
set -uo pipefail

die()  { printf 'gh-app: %s\n' "$*" >&2; exit 2; }
fail() { printf 'gh-app: %s\n' "$*" >&2; exit 1; }

API="https://api.github.com"

usage() {
  cat <<'EOF'
gh-app -- act on GitHub as a GitHub App

  gh-app check              mint a token; show app, org, reach, permissions, expiry
  gh-app exec <cmd...>      run one command with the app's token and identity
  gh-app help

Needs GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, GITHUB_APP_NAME, GITHUB_APP_ORG.
The token is never printed.
EOF
}

case "${1:-}" in
  check|exec) VERB="$1"; shift ;;
  help|-h|--help) usage; exit 0 ;;
  "") usage >&2; exit 2 ;;
  *) printf "gh-app: unknown verb '%s' (see 'gh-app help')\n" "$1" >&2; exit 1 ;;
esac
[[ "$VERB" == exec && $# -eq 0 ]] && die "exec needs a command, e.g. gh-app exec git push"

for c in curl jq openssl; do
  command -v "$c" >/dev/null 2>&1 || die "required command '$c' not found on PATH"
done
for v in GITHUB_APP_ID GITHUB_APP_PRIVATE_KEY GITHUB_APP_NAME GITHUB_APP_ORG; do
  [[ -n "${!v:-}" ]] || die "\$$v is not set -- it comes from SANDBOX_SECRETS in the avatar's harness/config"
done
[[ "$GITHUB_APP_ID" =~ ^[0-9]+$ ]] || die "\$GITHUB_APP_ID is not a numeric app id"

# ---------------------------------------------------------------- the JWT
b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

now=$(date +%s)
# iat 60 s in the past absorbs clock drift; GitHub refuses exp beyond 10 min.
header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
payload=$(jq -cn --argjson iat $((now - 60)) --argjson exp $((now + 540)) --arg iss "$GITHUB_APP_ID" \
  '{iat:$iat, exp:$exp, iss:$iss}' | b64url)
sig=$(printf '%s.%s' "$header" "$payload" \
  | openssl dgst -sha256 -sign <(printf '%s\n' "$GITHUB_APP_PRIVATE_KEY") 2>/dev/null | b64url) && [[ -n "$sig" ]] \
  || die "\$GITHUB_APP_PRIVATE_KEY is not a usable PEM private key (were its newlines kept?)"
JWT="$header.$payload.$sig"

# ---------------------------------------------------------------- requests
# The credential goes to curl on stdin (-K -), so it is not in any argv.
# Sets BODY and CODE; never exits, so each caller can name what went wrong.
api() {  # api <Bearer|token> <credential> <METHOD> <path>
  local out data=()
  [[ "$3" == POST ]] && data=(-d '{}')
  out=$(printf 'header = "Authorization: %s %s"\n' "$1" "$2" \
    | curl -sS -K - -X "$3" "${data[@]}" -w '\n%{http_code}' --max-time "${GH_APP_TIMEOUT:-30}" \
        -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28' \
        "$API$4") || fail "cannot reach $API$4"
  CODE="${out##*$'\n'}"; BODY="${out%$'\n'*}"
}
msg() { jq -r '.message // empty' <<<"$BODY" 2>/dev/null | head -c 200; }

api Bearer "$JWT" GET /app
case "$CODE" in
  200) ;;
  401) fail "GitHub rejected the JWT for app id $GITHUB_APP_ID: \$GITHUB_APP_PRIVATE_KEY is not this app's key, or \$GITHUB_APP_ID is wrong ($(msg))" ;;
  404) fail "GitHub has no app with id $GITHUB_APP_ID -- check \$GITHUB_APP_ID ($(msg))" ;;
  *)   fail "HTTP $CODE from GET /app: $(msg)" ;;
esac
SLUG=$(jq -r .slug <<<"$BODY"); NAME=$(jq -r .name <<<"$BODY")
want="${GITHUB_APP_NAME,,}"
[[ "$want" == "${SLUG,,}" || "$want" == "${NAME,,}" ]] \
  || fail "\$GITHUB_APP_NAME is '$GITHUB_APP_NAME' but app id $GITHUB_APP_ID is '$NAME' (slug $SLUG) -- the entries describe two different apps"

api Bearer "$JWT" GET "/orgs/$GITHUB_APP_ORG/installation"
case "$CODE" in
  200) ;;
  404) fail "app '$SLUG' is not installed on org '$GITHUB_APP_ORG' (or the org does not exist) -- check \$GITHUB_APP_ORG" ;;
  *)   fail "HTTP $CODE from GET /orgs/$GITHUB_APP_ORG/installation: $(msg)" ;;
esac
INST=$(jq -r .id <<<"$BODY")
SELECTION=$(jq -r .repository_selection <<<"$BODY")

api Bearer "$JWT" POST "/app/installations/$INST/access_tokens"
[[ "$CODE" == 201 ]] || fail "HTTP $CODE minting a token for installation $INST: $(msg)"
TOKEN=$(jq -r .token <<<"$BODY")
EXPIRES=$(jq -r .expires_at <<<"$BODY")
PERMS=$(jq -r '.permissions | to_entries | map("\(.key)=\(.value)") | join(", ")' <<<"$BODY")
BODY=""

# The bot user behind the app: its id makes the noreply address GitHub links
# commits to.
api token "$TOKEN" GET "/users/$SLUG%5Bbot%5D"
[[ "$CODE" == 200 ]] || fail "HTTP $CODE looking up user '$SLUG[bot]': $(msg)"
BOT_NAME="$SLUG[bot]"
BOT_EMAIL="$(jq -r .id <<<"$BODY")+$SLUG[bot]@users.noreply.github.com"

# ---------------------------------------------------------------- verbs
if [[ "$VERB" == check ]]; then
  api token "$TOKEN" GET "/installation/repositories?per_page=1"
  [[ "$CODE" == 200 ]] || fail "HTTP $CODE listing the installation's repositories: $(msg)"
  printf 'app          %s (slug %s, id %s)\n' "$NAME" "$SLUG" "$GITHUB_APP_ID"
  printf 'org          %s (installation %s, repositories: %s, %s reachable)\n' \
    "$GITHUB_APP_ORG" "$INST" "$SELECTION" "$(jq -r .total_count <<<"$BODY")"
  printf 'identity     %s <%s>\n' "$BOT_NAME" "$BOT_EMAIL"
  printf 'permissions  %s\n' "$PERMS"
  printf 'token        minted, expires %s (not shown)\n' "$EXPIRES"
  exit 0
fi

n=${GIT_CONFIG_COUNT:-0}
gitcfg() { export "GIT_CONFIG_KEY_$n=$1" "GIT_CONFIG_VALUE_$n=$2"; n=$((n + 1)); }
gitcfg credential.https://github.com.helper ""
gitcfg credential.https://github.com.helper '!gh auth git-credential'
gitcfg url.https://github.com/.insteadOf git@github.com:
export GIT_CONFIG_COUNT=$n
export GIT_AUTHOR_NAME="$BOT_NAME" GIT_AUTHOR_EMAIL="$BOT_EMAIL"
export GIT_COMMITTER_NAME="$BOT_NAME" GIT_COMMITTER_EMAIL="$BOT_EMAIL"
export GH_TOKEN="$TOKEN"
unset TOKEN JWT GITHUB_APP_PRIVATE_KEY
exec "$@"
